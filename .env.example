# Copy this file to .env, then change the two values marked CHANGE_ME.
# .env is private and ignored by Git.

POSTGRES_USER=n8n
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=n8n

# Any long random string, 32+ letters and numbers. Keep it: n8n uses it to encrypt saved credentials.
N8N_ENCRYPTION_KEY=CHANGE_ME

TIMEZONE=Europe/Paris
