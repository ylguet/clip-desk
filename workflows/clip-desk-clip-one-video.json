    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Runs once per video, after Vizard has finished (or refused / timed out)\nconst res = $json;\nconst submit = $('Vizard Submit').first().json;\nconst v = $('When Executed by Another Workflow').first().json;\n\nconst clips = (res.videos || []).map(c => ({\n  title: c.title,\n  url: c.videoUrl,\n  editorUrl: c.clipEditorUrl,\n  viralScore: c.viralScore,\n  seconds: Math.round((c.videoMsDuration || 0) / 1000),\n}));\n\nlet status;\nif (submit.code && Number(submit.code) !== 2000) {\n  status = `Vizard refused the video (code ${submit.code}${submit.errMsg ? ': ' + submit.errMsg : ''})`;\n} else if (Number(res.code) === 2000) {\n  status = 'ok';\n} else if (Number(res.code) === 1000) {\n  status = 'still processing when the time limit was reached';\n} else {\n  status = `Vizard error ${res.code ?? ''} ${res.errMsg || (res.error && res.error.message) || ''}`.trim();\n}\n\nreturn {\n  json: {\n    videoId: v.videoId,\n    title: v.title,\n    channel: v.channel,\n    views: v.views,\n    lengthMinutes: v.lengthMinutes,\n    url: v.url,\n    requestedBy: v.requestedBy,\n    status,\n    clips,\n  },\n};\n"
      },
      "id": "f687c63f-d113-46d5-aa3f-f796ef7cecda",
      "name": "Format Clips",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
